/** Dynamic survey web services. */

const DYNAMIC_SURVEY_WORKSPACE_KEYS_ = Object.freeze({
  CURRENT: "DYNAMIC_SURVEY_WORKSPACE_ID",
  SETTINGS: "DYNAMIC_SURVEY_SETTINGS_WORKSPACE_ID",
  MAPPING: "DYNAMIC_SURVEY_MAPPING_WORKSPACE_ID",
  RAW: "DYNAMIC_SURVEY_RAW_WORKSPACE_ID",
  RAW_REVISION: "DYNAMIC_SURVEY_RAW_WORKSPACE_REVISION"
});

const DYNAMIC_SURVEY_REVISION_KEYS_ = Object.freeze({
  RAW: "DYNAMIC_SURVEY_RAW_REVISION",
  STATISTICS: "DYNAMIC_SURVEY_STATISTICS_REVISION",
  QUALITY: "DYNAMIC_SURVEY_QUALITY_REVISION",
  QUALITY_STATUS: "DYNAMIC_SURVEY_QUALITY_STATUS",
  QUALITY_AI_ALLOWED: "DYNAMIC_SURVEY_QUALITY_AI_ALLOWED",
  AI: "DYNAMIC_SURVEY_AI_REVISION"
});

function getDynamicSurveyRevisionStore_() {
  return PropertiesService.getDocumentProperties();
}

function createDynamicSurveyWorkspaceId_() {
  return "ANL-" + Utilities.formatDate(new Date(), Session.getScriptTimeZone() || "Etc/UTC", "yyyyMMdd")
    + "-" + Utilities.getUuid().replace(/-/g, "").slice(0, 8).toUpperCase();
}

function beginDynamicSurveyWorkspaceFromWeb() {
  const properties = getDynamicSurveyRevisionStore_();
  const workspaceId = createDynamicSurveyWorkspaceId_();
  properties.setProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.CURRENT, workspaceId);
  [DYNAMIC_SURVEY_WORKSPACE_KEYS_.SETTINGS, DYNAMIC_SURVEY_WORKSPACE_KEYS_.MAPPING,
    DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW, DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW_REVISION].forEach(function(key) { properties.deleteProperty(key); });
  return {success:true, workspaceId:workspaceId};
}

function markDynamicSurveyWorkspaceStage_(stage, store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const workspaceId = properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.CURRENT) || "";
  const key = DYNAMIC_SURVEY_WORKSPACE_KEYS_[stage];
  if (workspaceId && key) {
    properties.setProperty(key, workspaceId);
    if (stage === "RAW") properties.setProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW_REVISION,
      properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW) || "");
  }
  return workspaceId;
}

function getDynamicSurveyWorkspaceState_(store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const workspaceId = properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.CURRENT) || "";
  if (!workspaceId) return {workspaceId:"",legacy:true,settingsCurrent:true,mappingCurrent:true,rawCurrent:true};
  return {
    workspaceId:workspaceId,
    legacy:false,
    settingsCurrent:properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.SETTINGS) === workspaceId,
    mappingCurrent:properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.MAPPING) === workspaceId,
    rawCurrent:properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW) === workspaceId
      && Boolean(properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW_REVISION))
      && properties.getProperty(DYNAMIC_SURVEY_WORKSPACE_KEYS_.RAW_REVISION)
        === properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW)
  };
}

function getDynamicSurveyRevisionState_(store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  return {
    rawRevision: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW) || "",
    statisticsRevision: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.STATISTICS) || "",
    qualityRevision: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY) || "",
    qualityStatus: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_STATUS) || "",
    qualityAiAllowed: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_AI_ALLOWED) === "true",
    aiRevision: properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.AI) || ""
  };
}

function buildDynamicSurveyFreshnessState_(revisionState, sheetState) {
  const revisions = revisionState || {};
  const sheets = sheetState || {};
  const rawRevision = revisions.rawRevision || "";
  const statisticsFresh = Boolean(rawRevision && sheets.statisticsSheetsComplete
    && revisions.statisticsRevision === rawRevision);
  const qualityFresh = Boolean(statisticsFresh && revisions.qualityRevision === rawRevision);
  const aiFresh = Boolean(qualityFresh && sheets.aiSheetsComplete && revisions.aiRevision === rawRevision);
  return {
    statisticsFresh: statisticsFresh,
    qualityFresh: qualityFresh,
    aiFresh: aiFresh,
    exportReady: Boolean(aiFresh && revisions.qualityAiAllowed)
  };
}

function markDynamicRawRevision_(store, revision) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const rawRevision = revision || Utilities.getUuid();
  properties.setProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW, rawRevision);
  [DYNAMIC_SURVEY_REVISION_KEYS_.STATISTICS, DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY,
    DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_STATUS, DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_AI_ALLOWED,
    DYNAMIC_SURVEY_REVISION_KEYS_.AI].forEach(function(key) { properties.deleteProperty(key); });
  return rawRevision;
}

function markDynamicStatisticsRevision_(rawRevision, store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const current = properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW) || "";
  if (!rawRevision || current !== rawRevision) throw new Error("원자료가 분석 중 변경되었습니다. 통계 분석을 다시 실행해 주세요.");
  properties.setProperty(DYNAMIC_SURVEY_REVISION_KEYS_.STATISTICS, rawRevision);
  [DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY, DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_STATUS,
    DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_AI_ALLOWED, DYNAMIC_SURVEY_REVISION_KEYS_.AI]
    .forEach(function(key) { properties.deleteProperty(key); });
}

function invalidateDynamicStatisticsRevision_(store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  [DYNAMIC_SURVEY_REVISION_KEYS_.STATISTICS, DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY,
    DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_STATUS, DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_AI_ALLOWED,
    DYNAMIC_SURVEY_REVISION_KEYS_.AI].forEach(function(key) { properties.deleteProperty(key); });
}

function invalidateDynamicAIRevision_(store) {
  (store || getDynamicSurveyRevisionStore_()).deleteProperty(DYNAMIC_SURVEY_REVISION_KEYS_.AI);
}

function markDynamicQualityRevision_(rawRevision, quality, store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  assertDynamicStatisticsFresh_(properties);
  if (properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW) !== rawRevision) {
    throw new Error("원자료가 품질검사 중 변경되었습니다. 통계 분석부터 다시 실행해 주세요.");
  }
  properties.setProperties((function() {
    const values = {};
    values[DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY] = rawRevision;
    values[DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_STATUS] = String(quality && quality.status || "NOT_RUN");
    values[DYNAMIC_SURVEY_REVISION_KEYS_.QUALITY_AI_ALLOWED] = String(Boolean(quality && quality.aiAllowed));
    return values;
  })());
  properties.deleteProperty(DYNAMIC_SURVEY_REVISION_KEYS_.AI);
}

function markDynamicAIRevision_(rawRevision, store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  assertDynamicQualityFresh_(properties, true);
  if (properties.getProperty(DYNAMIC_SURVEY_REVISION_KEYS_.RAW) !== rawRevision) {
    throw new Error("원자료가 AI 보고서 생성 중 변경되었습니다. 통계 분석부터 다시 실행해 주세요.");
  }
  properties.setProperty(DYNAMIC_SURVEY_REVISION_KEYS_.AI, rawRevision);
}

function assertDynamicStatisticsFresh_(store) {
  const revisions = getDynamicSurveyRevisionState_(store);
  if (!revisions.rawRevision || revisions.statisticsRevision !== revisions.rawRevision) {
    throw new Error("원자료가 변경되어 통계 결과가 최신 상태가 아닙니다. 통계 분석을 다시 실행해 주세요.");
  }
  return revisions;
}

function assertDynamicQualityFresh_(store, requireAiAllowed) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const revisions = assertDynamicStatisticsFresh_(properties);
  if (revisions.qualityRevision !== revisions.rawRevision) {
    throw new Error("현재 통계 결과에 대한 품질검사가 필요합니다. 품질검사를 다시 실행해 주세요.");
  }
  if (requireAiAllowed && !revisions.qualityAiAllowed) {
    throw new Error("품질검사 오류를 먼저 해결해 주세요.");
  }
  return revisions;
}

function assertDynamicAIReportFresh_(store) {
  const properties = store || getDynamicSurveyRevisionStore_();
  const revisions = assertDynamicQualityFresh_(properties, true);
  if (revisions.aiRevision !== revisions.rawRevision) {
    throw new Error("현재 원자료에 대한 AI 보고서가 없습니다. AI 분석을 다시 실행해 주세요.");
  }
  return revisions;
}

function prepareDynamicVisualizationExportFromWeb_(format, expectedRawRevision, store) {
  const revisions = assertDynamicAIReportFresh_(store);
  const expected = cleanText_(expectedRawRevision);
  if (expected && expected !== revisions.rawRevision) {
    throw new Error("시각화 파일 생성 중 원자료가 변경되었습니다. 최신 결과를 다시 확인해 주세요.");
  }
  return {
    success: true,
    format: String(format || "").toUpperCase(),
    rawRevision: revisions.rawRevision,
    message: "현재 설문 결과의 시각화 Export를 확인했습니다."
  };
}

function prepareDynamicVisualizationPdfExportFromWeb(expectedRawRevision) {
  return prepareDynamicVisualizationExportFromWeb_("PDF", expectedRawRevision);
}

function prepareDynamicVisualizationPngExportFromWeb(expectedRawRevision) {
  return prepareDynamicVisualizationExportFromWeb_("PNG", expectedRawRevision);
}

/**
 * 범용 만족도 조사 시스템의 현재 상태를 반환합니다.
 *
 * 확인 항목:
 * - 00_설정
 * - 10_문항매핑
 * - 09_범용원자료
 * - 01~06 범용 통계 보고서
 * - 07_AI총평
 * - 08_향후계획
 *
 * @return {Object}
 */
function getDynamicSurveySystemStatusFromWeb() {
  try {
    const spreadsheet =
      SpreadsheetApp.getActiveSpreadsheet();

    const settingsSheet =
      spreadsheet.getSheetByName(
        "00_설정"
      );

    const qualitySheet = spreadsheet.getSheetByName(
      DYNAMIC_SURVEY_CONFIG.SHEETS.QUALITY
    );

    const mappingSheet = spreadsheet.getSheetByName(DYNAMIC_SURVEY_CONFIG.SHEETS.MAPPING)
      || spreadsheet.getSheetByName(DYNAMIC_SURVEY_CONFIG.SHEETS.LEGACY_MAPPING);

    const rawSheet = spreadsheet.getSheetByName(DYNAMIC_SURVEY_CONFIG.SHEETS.RAW)
      || spreadsheet.getSheetByName(DYNAMIC_SURVEY_CONFIG.SHEETS.LEGACY_RAW);

    const statisticalSheetNames = [
      "01_조사개요",
      "02_대시보드",
      "03_응답자특성",
      "04_복수응답분석",
      "05_만족도분석",
      "06_주관식분석",
      "09_원자료"
    ];

    const aiSheetNames = [
      "07_AI총평",
      "08_향후개선방향"
    ];

    const statisticalSheetCount =
      statisticalSheetNames.filter(function(sheetName) {
        return Boolean(
          spreadsheet.getSheetByName(
            sheetName
          )
        );
      }).length;

    const aiSheetCount =
      aiSheetNames.filter(function(sheetName) {
        return Boolean(
          spreadsheet.getSheetByName(
            sheetName
          )
        );
      }).length;

    const mappingCount =
      mappingSheet
      && mappingSheet.getLastRow() >= 2
        ? mappingSheet.getLastRow() - 1
        : 0;

    const respondentCount =
      rawSheet
      && rawSheet.getLastRow() >= 2
        ? rawSheet.getLastRow() - 1
        : 0;

    const rawColumnCount =
      rawSheet
        ? rawSheet.getLastColumn()
        : 0;

    const settingsExists =
      Boolean(
        settingsSheet
        && settingsSheet.getLastRow() >= 2
      );

    const workspace = getDynamicSurveyWorkspaceState_();
    const mappingExists = workspace.mappingCurrent && mappingCount > 0;
    const rawSheetExists = workspace.rawCurrent && respondentCount > 0;

    const revisions = getDynamicSurveyRevisionState_();
    const freshness = buildDynamicSurveyFreshnessState_(revisions, {
      statisticsSheetsComplete: statisticalSheetCount === statisticalSheetNames.length,
      aiSheetsComplete: aiSheetCount === aiSheetNames.length
    });
    const statisticsComplete = workspace.rawCurrent && freshness.statisticsFresh;
    const aiComplete = workspace.rawCurrent && freshness.aiFresh;
    const qualityStatus = workspace.rawCurrent && freshness.qualityFresh
      ? (revisions.qualityStatus || "NOT_RUN")
      : (workspace.rawCurrent && (revisions.qualityRevision || qualitySheet) ? "STALE" : "NOT_RUN");
    const qualityAiAllowed = workspace.rawCurrent && freshness.qualityFresh && revisions.qualityAiAllowed;
    const exportReady =
      workspace.settingsCurrent
      && settingsExists
      && mappingExists
      && rawSheetExists
      && freshness.exportReady;

    return {
      success: true,

      settingsExists:
        workspace.settingsCurrent && settingsExists,

      workspaceId: workspace.workspaceId,
      workspaceLegacy: workspace.legacy,

      mappingExists:
        mappingExists,

      mappingCount:
        mappingExists ? mappingCount : 0,

      rawSheetExists:
        rawSheetExists,

      respondentCount:
        rawSheetExists ? respondentCount : 0,

      rawColumnCount:
        workspace.rawCurrent ? rawColumnCount : 0,

      statisticalSheetCount:
        statisticalSheetCount,

      statisticalSheetTotal:
        statisticalSheetNames.length,

      statisticsComplete:
        statisticsComplete,

      statisticsStale: rawSheetExists && !statisticsComplete,

      rawRevision: revisions.rawRevision,
      statisticsRevision: revisions.statisticsRevision,

      aiSheetCount:
        aiSheetCount,

      aiSheetTotal:
        aiSheetNames.length,

      aiComplete:
        aiComplete,

      aiRevision: revisions.aiRevision,
      aiStale: rawSheetExists && !aiComplete,

      exportReady:
        exportReady,

      qualityStatus: qualityStatus,
      qualityAiAllowed: qualityAiAllowed,
      qualityRevision: revisions.qualityRevision,
      qualityStale: rawSheetExists && !freshness.qualityFresh,

      message:
        "범용 시스템 상태를 확인했습니다."
    };

  } catch (error) {
    return {
      success: false,

      error:
        error && error.message
          ? error.message
          : String(error)
    };
  }
}



